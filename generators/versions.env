# Every generator and toolchain the SDKs are built with — ONE place, read by the Makefile and CI.
# Rule 14 (OZB CLAUDE.md): latest STABLE at the time of pinning, checked 2026-09-25. Bumping one is a
# PR that regenerates sdks/ in the same commit (CI fails otherwise — the committed output must equal
# a fresh generation).

# TypeScript — openapi-typescript (types from the spec) + openapi-fetch (the ~6 kB typed fetch runtime)
OPENAPI_TYPESCRIPT_VERSION=7.13.0
OPENAPI_FETCH_VERSION=0.17.0
TYPESCRIPT_VERSION=7.0.2

# Python — openapi-python-client (httpx + attrs); ruff is its post-hook formatter, pinned so the
# formatting cannot drift between machines
OPENAPI_PYTHON_CLIENT_VERSION=0.29.1
RUFF_VERSION=0.16.9
PYTHON_VERSION=3.14
# examples/python is type-checked with it (--strict via examples/python/pyproject.toml)
MYPY_VERSION=2.3.1
# uv runs openapi-python-client, ruff, mypy and the examples (CI installs exactly this one)
UV_VERSION=0.12.18

# Go — oapi-codegen (models + client) and the runtime it imports
OAPI_CODEGEN_VERSION=v2.8.0
OAPI_CODEGEN_RUNTIME_VERSION=v1.7.0
GO_VERSION=1.27.1

# PHP + C# — openapi-generator (php · csharp/generichost), run from its official image
OPENAPI_GENERATOR_IMAGE=openapitools/openapi-generator-cli:v7.25.0@sha256:2ab0a9680222de65dc9d3baf861aa02b99e1b80c211d8221ebf3ae8f8a102524
PHP_IMAGE=php:8.5-cli@sha256:c8572660ef90c65534f96637e614032829a805107fb3122762549eb6162584c1
DOTNET_IMAGE=mcr.microsoft.com/dotnet/sdk:10.0@sha256:35d40304542c8689331f8cab17c65926cdf48fe711e289321d71924b230a7d29
# Composer — installs the PHP example against sdks/php (its image carries PHP 8.5 + curl/mbstring, so it also runs it)
COMPOSER_IMAGE=composer:2.10.3@sha256:a5f59b9fd2faf31218632be4809dc6491761085e8064c31dc3b84378c48c248b

NODE_VERSION=24
