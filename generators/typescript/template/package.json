{
  "name": "@dona/api",
  "version": "@SDK_VERSION@",
  "description": "Dona API — typed TypeScript client, generated from the OpenAPI contract. Do not edit: regenerate.",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "src", "README.md"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "npm run build"
  },
  "dependencies": {
    "openapi-fetch": "@OPENAPI_FETCH_VERSION@"
  },
  "devDependencies": {
    "typescript": "@TYPESCRIPT_VERSION@"
  }
}
