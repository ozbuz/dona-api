<Project Sdk="Microsoft.NET.Sdk">
  <!-- Runnable Dona API examples. Usage: see Program.cs (quickstart, webhook-selftest). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
  </PropertyGroup>
  <ItemGroup>
    <!-- In your own project: `dotnet add package Dona.Api` once it is published (S6). -->
    <ProjectReference Include="../../sdks/csharp/src/Dona.Api/Dona.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../testdata/webhook-vectors.json" Link="testdata/webhook-vectors.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
